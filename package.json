{
  "name": "country-search",
  "version": "1.0.0",
  "description": "Живой поиск стран по имени через публичный countries.dev (GET https://countries.dev/name/{query}, без ключа и регистрации, с поддержкой CORS). Пользователь печатает — приложение само, по мере ввода, посылает запросы и показывает результаты.",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romanusovich/country-search.git"
  },
  "keywords": [],
  "author": "Raman Usovich",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/romanusovich/country-search/issues"
  },
  "homepage": "https://github.com/romanusovich/country-search#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css}": "prettier --write"
  }
}
